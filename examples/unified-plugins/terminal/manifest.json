      "path": "frontend.mjs"
    },
    {
      "id": "backend",
      "kind": "backend",
      "path": "backend.py"
    },
    {
      "id": "desktop",
      "kind": "desktop",
      "path": "desktop.mjs"
    }
  ]
}
