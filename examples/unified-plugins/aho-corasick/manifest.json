        "haystack": "ushers 波浪-wave-WAVE",
        "patterns": ["he", "she", "hers", "波浪", "wave"],
        "asciiCaseInsensitive": true,
        "overlapping": true,
        "maxMatches": 100
      }
    }
  ]
}
