    "license": "GPL-3.0-only",
    "engines": {
      "candlescope": ">=0.4.0 <0.5.0"
    }
  },
  "backend": {
    "entrypoints": [
      {
        "id": "main",
        "pythonModule": "candlescope_plugin_pyne_workbench.plugin",
        "resourceProfile": "standard",
        "activationEvents": [
          "onCommand",
          "onView"
        ]
      },
      {
        "id": "pyne-workbench",
        "pythonModule": "candlescope_plugin_pyne_workbench.strategy_entrypoint",
        "resourceProfile": "standard",
        "activationEvents": [
          "onCommand"
        ]
      }
    ]
  },
  "frontend": {
    "assetsRoot": "web",
    "surfaces": [
      {
        "id": "workbench-view",
        "type": "sandbox",
        "entry": "index.html",
        "slot": "side-panel"
      }
    ]
  },
