diff --git a/tests/test_event_request_series.py b/tests/test_event_request_series.py
new file mode 100644
index 0000000..887d4e0
--- /dev/null
+++ b/tests/test_event_request_series.py
@@ -0,0 +1,121 @@
+import pytest
+import pyne_runtime as pn
+
+
+def row(time, close, time_close):
+    return dict(time=time, time_close=time_close, open=close, high=close, low=close,
+                close=close, volume=1)
+
+
+class Events:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def get_ohlcv(self, symbol, timeframe, start, end):
+        return [dict(item) for item in self.rows if start <= item["time"] <= end]
+
+    def get_request_metadata(self, symbol, timeframe):
+        return {"event_series": "source-close-events/1"}
+
+
+BATCH = '''indicator("Event history")
+values = request.security("events", "1", ["close", "close[1]"])
+plot(values[0], "Last")
+plot(values[1], "Previous")
+plot(request.security("events", "1", "close", gaps="on"), "Gaps")
+'''
+INCREMENTAL = '''indicator("Event history", mode="incremental")
+def on_bar(ctx, bar):
+    values = request.security("events", "1", ["close", "close[1]"])
+    ctx.plot("Last", values[0])
+    ctx.plot("Previous", values[1])
+    ctx.plot("Gaps", request.security("events", "1", "close", gaps="on"))
+'''
+
+
+def normalized(result, bars):
+    return {name: [next((float(point["value"]) for point in line["data"]
+                        if point["time"] == bar["time"]), None) for bar in bars]
+            for name in ("Last", "Previous", "Gaps")
+            for line in [next((line for line in result.lines if line["name"] == name), {"data": []})]}
+
+
+def test_cohorts_sparse_events_and_every_incremental_prefix():
+    bars = [row(60 * i, 10, 60 * (i + 1)) for i in range(1, 9)]
+    provider = Events([row(120, 11, 180), row(120, 12, 180), row(300, 13, 360),
+                       row(420, 14, 480), row(420, 15, 480), row(600, 99, 660)])
+    result = pn.run(BATCH, bars, data_provider=provider, timeframe="1", executor_mode="inline")
+    assert result.ok, result.error
+    assert normalized(result, bars) == {
+        "Last": [None, 12, 12, 12, 13, 13, 15, 15],
+        "Previous": [None, 11, 11, 11, 12, 12, 14, 14],
+        "Gaps": [None, 12, None, None, 13, None, 15, None],
+    }
+    session = pn.PyneIncrementalSession(script=INCREMENTAL,
+        settings=pn.PyneSettings(data_provider=provider, timeframe=pn.TimeframeInfo.from_value("1")))
+    for count, bar in enumerate(bars, 1):
+        stepped = session.on_bar_closed(bar)
+        assert stepped.ok, stepped.error
+        expected = normalized(result, bars)
+        assert normalized(session.snapshot_result(), bars[:count]) == {key: values[:count] for key, values in expected.items()}
+    snapshot = session.snapshot_state()
+    restored = pn.PyneIncrementalSession.from_snapshot(snapshot, script=INCREMENTAL,
+        settings=pn.PyneSettings(data_provider=provider, timeframe=pn.TimeframeInfo.from_value("1")))
+    assert normalized(restored.on_bar_closed(row(540, 10, 600)), [*bars, row(540, 10, 600)]) == normalized(
+        session.on_bar_closed(row(540, 10, 600)), [*bars, row(540, 10, 600)])
+
+
+def test_source_higher_timeframe_does_not_publish_at_its_open():
+    bars = [row(i*60, 10, (i+1)*60) for i in range(5)]
+    provider = Events([row(0, 20, 300), row(0, 21, 300)])
+    result = pn.run(BATCH, bars, data_provider=provider, timeframe="1", executor_mode="inline")
+    assert result.ok, result.error
+    assert normalized(result, bars)["Last"] == [None, None, None, None, 21]
+
+
+@pytest.mark.parametrize("close", [None, 0, -1, True, 120.5])
+def test_invalid_confirmation_is_rejected(close):
+    result = pn.run(BATCH, [row(60, 10, 120)], data_provider=Events([row(60, 11, close)]),
+                    timeframe="1", executor_mode="inline")
+    assert not result.ok
+
+
+def test_event_lookahead_is_explicitly_rejected():
+    source = 'plot(request.security("events", "1", "close", lookahead="on"))'
+    result = pn.run(source, [row(60, 10, 120)], data_provider=Events([row(60, 11, 120)]),
+                    timeframe="1", executor_mode="inline")
+    assert not result.ok
+    assert "lookahead_off" in result.error
+
+
+def test_calendar_source_confirms_only_at_explicit_month_boundary():
+    # February in a leap year: do not approximate the duration with 30 days.
+    feb, march = 1706745600, 1709251200
+    bars = [row(march-120, 10, march-60), row(march-60, 10, march)]
+    result = pn.run(BATCH.replace('"1"', '"1M"'), bars, data_provider=Events([row(feb, 20, march)]),
+                    timeframe="1", executor_mode="inline")
+    assert result.ok, result.error
+    assert normalized(result, bars)["Last"] == [None, 20]
+
+
+def test_lower_timeframe_event_arrays_do_not_leak_opening_time_values():
+    result = pn.run('plot(request.security_lower_tf("events", "1", "close").last())',
+        [row(60, 10, 360)], timeframe="5", executor_mode="inline",
+        data_provider=Events([row(60, 20, 600)]))
+    assert not result.ok
+    assert "security_lower_tf event arrays" in result.error
+
+
+def test_event_preview_isolation_and_backward_restore():
+    provider = Events([row(120, 11, 180), row(120, 12, 180), row(300, 13, 360)])
+    settings = pn.PyneSettings(data_provider=provider, timeframe=pn.TimeframeInfo.from_value("1"))
+    session = pn.PyneIncrementalSession(script=INCREMENTAL, settings=settings)
+    session.seed([row(60, 10, 120)])
+    checkpoint = session.snapshot_state()
+    before = session.snapshot_portable_state()
+    session.on_bar_updated(row(120, 10, 180))
+    assert session.snapshot_portable_state() == before
+    expected = session.on_bar_closed(row(120, 10, 180))
+    session.on_bar_closed(row(180, 10, 240))
+    restored = pn.PyneIncrementalSession.from_snapshot(checkpoint, script=INCREMENTAL, settings=settings)
+    assert restored.on_bar_closed(row(120, 10, 180)).lines == expected.lines
