@@ -0,0 +1,67 @@
+"""Opt-in event history, confirmed by explicit source close boundaries.
+
+Providers own event construction. Ordinals (including equal timestamps) own
+history references; the last confirmed event in each cohort owns projection.
+Legacy time-series alignment is unchanged.
+"""
+from bisect import bisect_right
+import math
+from numbers import Integral
+
+import numpy as np
+
+from ..series import PyneSeries
+from ..values import is_na_value
+from .errors import PyneRequestError
+
+
+def event_close_times(rows, times):
+    closes = []
+    for row, stamp in zip(rows, times, strict=True):
+        close = row.get("time_close")
+        if isinstance(close, bool) or not isinstance(close, Integral):
+            raise PyneRequestError("event rows require integer time_close", code="PYNE_RUNTIME_ERROR")
+        close = int(close)
+        if close > 10_000_000_000:
+            close //= 1000
+        if close <= stamp or (closes and close < closes[-1]):
+            raise PyneRequestError("event confirmation times must be ordered after their opens",
+                                   code="PYNE_RUNTIME_ERROR")
+        closes.append(close)
+    return closes
+
+
+def event_security_result(*, context, event_closes, requested_values, expression_name,
+                          symbol, timeframe, gaps, lookahead, current_only):
+    if lookahead != "off":
+        raise PyneRequestError("event series require lookahead_off", code="PYNE_UNSUPPORTED_FEATURE")
+    indices = [len(context.times) - 1] if current_only else range(len(context.times))
+    declared_closes = context.time_close.to_numpy()
+    try:
+        duration = int(context.timeframe.in_seconds())
+    except (ValueError, TypeError):
+        duration = None
+    selections = []
+    for index in indices:
+        stamp = context.times[index]
+        metadata_index = -1 if current_only else index
+        explicit = bool(context._time_close_explicit and context._time_close_explicit[metadata_index])
+        close = declared_closes[metadata_index] if explicit else stamp + duration if duration else math.nan
+        if not math.isfinite(close) or close <= stamp:
+            raise PyneRequestError("event projection requires chart close boundaries",
+                                   code="PYNE_RUNTIME_ERROR")
+        selected = bisect_right(event_closes, close) - 1
+        if selected >= 0 and gaps == "on" and event_closes[selected] <= stamp:
+            selected = -1
+        selections.append(selected)
+
+    def project(values, name):
+        aligned = [np.nan if index < 0 or is_na_value(values[index]) else float(values[index])
+                   for index in selections]
+        return PyneSeries(np.asarray(aligned, dtype=np.float64),
+                          name=f"request.security({symbol},{timeframe},{name})")
+
+    if isinstance(requested_values, tuple):
+        return tuple(project(values, f"{expression_name}[{index}]")
+                     for index, values in enumerate(requested_values))
+    return project(requested_values, expression_name)
