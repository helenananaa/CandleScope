new file mode 100644
index 000000000..351dc9f4d
--- /dev/null
+++ b/python/tests/test_host_bar_boundaries.py
@@ -0,0 +1,56 @@
+"""Host-neutral boundary contract: no host timezone or service dependency."""
+import pytest
+import pine_compat
+
+DAY = 86400000
+# Irregular, contiguous windows model a DST transition.
+WINDOWS = [[0, DAY], [DAY, 2*DAY-3600000], [2*DAY-3600000, 3*DAY-3600000], [3*DAY-3600000, 4*DAY-3600000]]
+BARS = [dict(time=a, open=1, high=2, low=0, close=1, volume=1) for a, _ in WINDOWS]
+
+def options(windows=WINDOWS):
+    return dict(chart_symbol="TEST", chart_timeframe="1D", request_bars={
+        "TEST:1D": BARS,
+        "TEST:2D": [BARS[0], BARS[2]],
+        "$boundaries": {
+            "TEST:1D": dict(id="test-day/1", windows=windows),
+            "TEST:2D": dict(id="test-two-days/1", windows=[[0, WINDOWS[1][1]], [WINDOWS[2][0], WINDOWS[3][1]]]),
+        }})
+
+def test_aliases_close_cross_period_and_changes():
+    result = pine_compat.run_script('''//@version=6
+indicator("windows")
+plot(time_close)
+plot(time_close("D"))
+plot(time_close("2D"))
+plot(request.security(syminfo.tickerid, "D", time_close))
+plot(timeframe.change("2D") ? 1 : 0)
+''', BARS, **options())
+    assert [p["values"] for p in result["plots"]] == [
+        [b for _, b in WINDOWS], [b for _, b in WINDOWS],
+        [WINDOWS[1][1]]*2 + [WINDOWS[3][1]]*2,
+        [b for _, b in WINDOWS], [0, 0, 1, 0]]
+
+@pytest.mark.parametrize("windows", [[], [[1, 0]], [[0, 2], [1, 3]], [[False, DAY]], [[0, DAY, 1]]])
+def test_invalid_windows_fail(windows):
+    with pytest.raises((ValueError, TypeError)):
+        pine_compat.run_script('//@version=6\nindicator("bad")\nplot(time_close)', BARS, **options(windows))
+
+@pytest.mark.parametrize("expr", ['time_close("3D")', 'timeframe.change("3D") ? 1 : 0'])
+def test_unfrozen_timeframe_fails_instead_of_using_utc(expr):
+    with pytest.raises(ValueError, match="E_BAR_BOUNDARIES_MISSING"):
+        pine_compat.run_script('//@version=6\nindicator("missing")\nplot(' + expr + ')', BARS, **options())
+
+def test_missing_chart_window_fails():
+    with pytest.raises(ValueError, match="E_BAR_BOUNDARIES_MISSING"):
+        pine_compat.run_script('//@version=6\nindicator("missing")\nplot(time_close)', BARS, **options(WINDOWS[:2]))
+
+def test_realtime_replacement_and_confirmation_match_batch():
+    source = '//@version=6\nindicator("stream")\nplot(time_close)\nplot(ta.sma(close, 2))'
+    session = pine_compat.create_realtime_session(source, **options())
+    session.seed(BARS[:1])
+    session.update_forming({**BARS[1], "close": 2})
+    session.update_forming(BARS[1])
+    session.update_confirmed(BARS[1])
+    for bar in BARS[2:]:
+        session.update_confirmed(bar)
+    assert session.result()["plots"] == pine_compat.run_script(source, BARS, **options())["plots"]
