+"""Opt-in streaming chart ordinals keep real source milliseconds and rollback."""
+import pytest
+import pine_compat
+
+
+def test_external_ordered_events_require_opt_in_and_keep_the_external_ledger():
+    source='//@version=6\nstrategy("Events",calc_on_every_tick=true)\nplot(time)\nplot(bar_index)\nplot(strategy.position_size)'
+    program=pine_compat.compile_script(source)
+    for ordered in (False,True):
+        session=program.external_session(scheduled=True,ordered_chart=ordered)
+        for index in range(2):
+            bar=dict(time=1501,open=10,high=11,low=10,close=11,volume=1)
+            if index and not ordered:
+                with pytest.raises(ValueError,match='invalid external stream bar'):session.begin_bar(bar,bar_state='realtime')
+                break
+            session.begin_bar(bar,bar_state='realtime')
+            account=dict(time=1501,position_size=index,position_avg_price=10 if index else None,equity=1000,initial_capital=1000,netprofit=0,openprofit=0)
+            session.observe(dict(evaluation=dict(bar=bar,account=account,event_time_ms=1510+index,confirmed=True),
+                context=dict(bar_state='realtime',trigger='bar_close',is_new=True)))
+            session.commit_bar()
+        if ordered:
+            output=session.snapshot()['output']
+            assert output['plots'][0]['values']==[1501,1501]
+            assert output['plots'][1]['values']==[0,1]
+            assert output['plots'][2]['values']==[0,1]
+            assert 'strategy' not in output
diff --git a/python/tests/test_historical_extension.py b/python/tests/test_historical_extension.py
new file mode 100644
index 0000000..3fe7d4a
--- /dev/null
+++ b/python/tests/test_historical_extension.py
@@ -0,0 +1,146 @@
+"""A fixed history extended with newly closed bars equals one dataset of every bar.
+
+Hosts that follow live bars keep a historical session and extend it as bars close
+instead of executing the whole prefix again. These checks pin the equality for
+broker scripts and the cases where it intentionally does not hold.
+"""
+from __future__ import annotations
+
+import math
+
+import pytest
+
+import pine_compat
+
+STRATEGIES = {
+    "market": '''//@version=6
+strategy("Market", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=50)
+fast = ta.sma(close, 3)
+slow = ta.sma(close, 8)
+if ta.crossover(fast, slow)
+    strategy.entry("L", strategy.long)
+if ta.crossunder(fast, slow)
+    strategy.close("L")
+plot(fast)
+''',
+    "limits_stops_brackets": '''//@version=6
+strategy("Orders", overlay=true, initial_capital=10000, pyramiding=2, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2)
+r = ta.rsi(close, 5)
+if r < 35
+    strategy.entry("L", strategy.long, limit=close - 0.3)
+if r > 65
+    strategy.entry("S", strategy.short, stop=close - 0.2)
+strategy.exit("XL", "L", profit=80, loss=60)
+strategy.exit("XS", "S", trail_points=50, trail_offset=20)
+plot(r)
+''',
+    "orders_on_close": '''//@version=6
+strategy("Close", overlay=true, initial_capital=10000, process_orders_on_close=true, default_qty_type=strategy.percent_of_equity, default_qty_value=30)
+if ta.crossover(close, ta.ema(close, 9))
+    strategy.entry("L", strategy.long)
+if ta.crossunder(close, ta.ema(close, 9))
+    strategy.entry("S", strategy.short)
+plot(ta.ema(close, 9))
+''',
+    "every_history_tick": '''//@version=6
+strategy("Ticks", overlay=true, initial_capital=10000, calc_on_every_history_tick=true, default_qty_type=strategy.percent_of_equity, default_qty_value=25)
+if close > ta.sma(close, 6)
+    strategy.entry("L", strategy.long, stop=high)
+strategy.exit("XL", "L", profit=40, loss=40)
+plot(close)
+''',
+}
+
+
+def _bars(count, seed=0):
+    rows = []
+    for index in range(count):
+        close = 100 + 10 * math.sin((index + seed) / 7.0) + ((index * 7 + seed) % 5) * 0.3
+        open_ = close - 0.5 if index % 2 else close + 0.5
+        rows.append({"time": 1_700_000_000_000 + index * 60_000, "open": open_, "high": max(open_, close) + 1,
+                     "low": min(open_, close) - 1, "close": close, "volume": 10.0})
+    return rows
+
+
+def _session(program, bars, clocks):
+    return program.historical_session(bars, chart_symbol="BINANCE:BTCUSDT", chart_timeframe="1",
+                                      execution_times=clocks)
+
+
+def _extended(program, bars, clocks, first, steps):
+    session = _session(program, bars[:first], None if clocks is None else clocks[:first])
+    session.advance(first)
+    count = first
+    for step in steps:
+        session.extend(bars[count:count + step],
+                       execution_times=None if clocks is None else clocks[count:count + step])
+        count += step
+        output = session.advance(count)
+    assert count == len(bars) and session.cursor == count
+    return output
+
+
+@pytest.mark.parametrize("name", sorted(STRATEGIES))
+@pytest.mark.parametrize("clocked", [False, True])
+def test_extension_equals_the_complete_dataset(name, clocked):
+    program = pine_compat.compile_script(STRATEGIES[name])
+    bars = _bars(360, seed=len(name))
+    clocks = [bar["time"] + 59_999 for bar in bars] if clocked else None
+    complete = program.run(bars, chart_symbol="BINANCE:BTCUSDT", chart_timeframe="1", execution_times=clocks)
+    assert complete["strategy"]["trades"], "fixture must trade"
+    assert _extended(program, bars, clocks, 240, [1] * 120) == complete
+    assert _extended(program, bars, clocks, 60, [7, 50, 1, 2, 240]) == complete
+
+
+def test_the_horizon_moves_with_the_extension():
+    program = pine_compat.compile_script('''//@version=6
+strategy("Horizon")
+plot(last_bar_index)
+plot(barstate.islast ? 1 : 0)
+''')
+    bars = _bars(20)
+    session = _session(program, bars[:10], None)
+    session.advance(10)
+    session.extend(bars[10:])
+    plots = session.advance(20)["plots"]
+    # Earlier bars saw the horizon they were executed under; this is why hosts
+    # keep full rebuilds for scripts that read it.
+    assert plots[0]["values"][9] == 9 and plots[0]["values"][19] == 19
+    assert plots[1]["values"][9] == 1 and plots[1]["values"][19] == 1
+    complete = program.run(bars, chart_symbol="BINANCE:BTCUSDT", chart_timeframe="1")["plots"]
+    assert complete[1]["values"][9] == 0
+
+
+def test_extension_is_strict():
+    program = pine_compat.compile_script(STRATEGIES["market"])
+    bars = _bars(30)
+    session = _session(program, bars[:10], None)
+    with pytest.raises(ValueError, match="reach its horizon"):
+        session.extend(bars[10:12])
+    session.advance(10)
+    with pytest.raises(ValueError, match="cannot be empty"):
+        session.extend([])
+    with pytest.raises(ValueError, match="follow the session's last bar"):
+        session.extend(bars[9:12])
+    with pytest.raises(ValueError, match="execution_times"):
+        session.extend(bars[10:12], execution_times=[1, 2])
+    clocked = _session(program, bars[:10], [bar["time"] + 59_999 for bar in bars[:10]])
+    clocked.advance(10)
+    with pytest.raises(ValueError, match="execution_times"):
+        clocked.extend(bars[10:12])
+    # A rejected extension leaves the session usable.
+    session.extend(bars[10:12])
+    assert session.advance(12) == program.run(bars[:12], chart_symbol="BINANCE:BTCUSDT", chart_timeframe="1")
+
+
+def test_a_fork_keeps_its_own_horizon():
+    program = pine_compat.compile_script(STRATEGIES["market"])
+    bars = _bars(40)
+    session = _session(program, bars[:20], None)
+    session.advance(20)
+    fork = session.fork()
+    session.extend(bars[20:])
+    session.advance(40)
+    with pytest.raises(ValueError, match="outside forward range"):
+        fork.advance(21)
+    assert fork.cursor == 20
