+"""Ordered chart input is explicit and only the external account owns fills."""
+import pytest
+import pine_compat
+
+
+def test_repeated_source_clock_keeps_distinct_strategy_rows_and_account_authority():
+    program=pine_compat.compile_script('//@version=6\nstrategy("Ordered")\nplot(ta.sma(close,2))\nplot(bar_index)\nplot(time)\nplot(strategy.position_size)\nif bar_index==1\n    strategy.entry("L",strategy.long,qty=1)')
+    bars=[dict(time=60000,open=c,high=c,low=c,close=c,volume=1) for c in (10,12,14)]
+    accounts=[dict(time=60000,position_size=0,position_avg_price=None,equity=1000,initial_capital=1000,netprofit=0,openprofit=0)]*3
+    with pytest.raises(ValueError,match='duplicate bar time'):program.run_external(bars,accounts)
+    result=program.run_external(bars,accounts,ordered_chart=True,execution_times=[119999]*3)
+    assert result['intents'][0]['bar_index']==1
+    assert result['output'].get('strategy') is None
+    assert result['output']['plots'][0]['values']==[None,11.,13.]
+    assert result['output']['plots'][1]['values']==[0,1,2]
+    assert result['output']['plots'][2]['values']==[60000]*3
+    assert result['output']['plots'][3]['values']==[0.,0.,0.]
+    with pytest.raises(ValueError,match='nondecreasing'):
+        program.run_external([{**bars[0],'time':120000},*bars[1:]],accounts,ordered_chart=True)
